<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <RootNamespace>BasicInstaller</RootNamespace>
    <AssemblyName>BasicInstaller</AssemblyName>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- ApplicationIcon akzeptiert einen relativen Pfad auch ausserhalb des Projektordners
         (geht direkt an den Resource-Compiler) - kein lokales Kopieren noetig. -->
    <ApplicationIcon>..\..\assets\app.ico</ApplicationIcon>
    <Nullable>disable</Nullable>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>

  <PropertyGroup>
    <!-- Versionsangaben: beim Release-Bump hier hochzaehlen (siehe auch installer\setup.iss, dort manuell synchron halten) -->
    <Version>0.1.0</Version>
    <AssemblyVersion>0.1.0.0</AssemblyVersion>
    <FileVersion>0.1.0.0</FileVersion>
    <Company>AS Computertechnik</Company>
    <Product>Basic Software Installer</Product>
    <Copyright>© 2026 AS Computertechnik</Copyright>
  </PropertyGroup>

  <ItemGroup>
    <!-- Alle Teil des .NET Framework 4.8 - kein NuGet-Restore notwendig -->
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.Drawing" />
    <Reference Include="System.Web.Extensions" />
    <!-- fuer JavaScriptSerializer -->
    <Reference Include="System.Net.Http" />
    <!-- fuer ZipFile.ExtractToDirectory (AutoUpdateService) -->
    <Reference Include="System.IO.Compression" />
    <Reference Include="System.IO.Compression.FileSystem" />
    <!-- fuer "dynamic" (ShortcutCreator - spaet gebundenes COM, kein fester
         Interop-Referenzverweis noetig) -->
    <Reference Include="Microsoft.CSharp" />
  </ItemGroup>

  <ItemGroup>
    <!-- app.ico liegt in assets/, wird hier als Link ins Projekt eingebunden:
         einmal fuer die ApplicationIcon-Ressource der exe selbst (Pfad oben),
         und als Content, damit die lose Datei neben der exe im Output landet
         (MainForm.cs laedt sie zur Laufzeit per new Icon(...)). -->
    <Content Include="..\..\assets\app.ico" Link="app.ico" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\catalog\apps.json" Link="catalog\apps.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
